# services/api/.dev.vars — Worker secrets for `wrangler dev`. Never commit the real file.
# Deployed values are set with `wrangler secret put <NAME> --env staging|production`.

# Signs sessions. At least 32 random characters: `openssl rand -base64 32`.
# Use a different value in every environment.
BETTER_AUTH_SECRET=

# Optional. Google sign-in is offered only when both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
