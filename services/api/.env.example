# services/api/.env — read by wrangler and drizzle-kit on your machine. Never commit the real file.

# Neon DIRECT (non-pooled) connection string of your development branch. Used by `pnpm db:migrate`.
DATABASE_URL=

# The same development connection string. `wrangler dev` uses it in place of Hyperdrive locally.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=
