{
  "name": "@ridesphere/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy:staging": "wrangler deploy --env staging",
    "typegen": "wrangler types",
    "lint": "wrangler types > /dev/null && eslint .",
    "typecheck": "wrangler types > /dev/null && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@ridesphere/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@ridesphere/config": "workspace:*",
    "@types/node": "^26.6.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
