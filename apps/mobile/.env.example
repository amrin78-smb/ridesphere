# apps/mobile/.env — EXPO_PUBLIC_* values are compiled into the app and visible to anyone.
# Only public identifiers belong here, never secrets.

# Base URL of the API, without /api/v1. For a phone on your network use your computer's LAN
# address, for example http://192.168.1.20:8787 (not localhost).
EXPO_PUBLIC_API_BASE_URL=
