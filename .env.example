# RideSphere environment reference.
# Names and descriptions only. Never put real values in this file.
# Final names are confirmed when each integration is implemented; keep this file in step.

# ---------------------------------------------------------------------------
# API (Cloudflare Worker) — local values go in services/api/.dev.vars
# The R2, Sentry, email and payment names below are reserved for later increments and
# are not read by the code yet.
# Deployed values: `wrangler secret put <NAME> --env staging|production`
# ---------------------------------------------------------------------------

# Deployment environment: local | preview | staging | production
APP_ENV=local

# Better Auth signing secret, at least 32 random characters. Secret: .dev.vars locally,
# `wrangler secret put` when deployed. Different in every environment.
BETTER_AUTH_SECRET=

# Public origin of the API. Not a secret: set per environment in wrangler.jsonc.
BETTER_AUTH_URL=

# Optional secrets. A sign-in provider is offered only when all of its values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

# R2 S3-API credentials used only to presign upload/download URLs
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Error reporting DSN for the API (optional locally)
SENTRY_DSN=

# Transactional email provider key (provider not yet selected)
EMAIL_API_KEY=

# Payments — leave unset until the gateway and transaction type are approved
PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Not secrets, declared in wrangler.jsonc as bindings rather than here:
#   HYPERDRIVE   Hyperdrive config pointing at the Neon database
#   MEDIA        R2 bucket binding
#   RATE_LIMITER Rate limiting binding

# ---------------------------------------------------------------------------
# Database (services/api/.env) — see services/api/.env.example
# ---------------------------------------------------------------------------

# Neon DIRECT (non-pooled) connection string for the target branch. Used by drizzle-kit.
DATABASE_URL=

# Connection string `wrangler dev` uses in place of Hyperdrive. Development branch only.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=

# ---------------------------------------------------------------------------
# Mobile (Expo) — apps/mobile/.env, see apps/mobile/.env.example
# Only EXPO_PUBLIC_API_BASE_URL is read by the code so far.
# EXPO_PUBLIC_* values are compiled into the app and visible to anyone.
# Only publishable identifiers belong here, never secrets.
# ---------------------------------------------------------------------------

EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_MAP_PUBLIC_TOKEN=
EXPO_PUBLIC_SENTRY_DSN=
